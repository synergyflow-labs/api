{
  "JwtSettings": {
    "Issuer": "SynergyFlow.Api",
    "Audiences": ["SynergyFlow.Client"],
    "Secret": "CHANGE_ME_TO_A_32_CHAR_MINIMUM_SECRET_KEY_PLEASE!",
    "ExpiryMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "SynergyFlow.Api"
    }
  },
  "CorsSettings": {
    "PolicyName": "SynergyFlowCorsPolicy",
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:4200"]
  },
  "PostgresSettings": {
    "DefaultConnection": "Host=localhost;Database=synergyflow_dev;Username=postgres;Password=postgres",
    "MaximumPoolSize": 100,
    "MinimumPoolSize": 0,
    "ConnectionTimeoutSeconds": 15
  },
  "RateLimiterSettings": {
    "DisableRateLimiting": false,
    "GlobalConcurrencyPermitLimit": 50,
    "GlobalConcurrencyQueueLimit": 100,
    "AuthWindowMinutes": 1,
    "AuthPermitLimit": 5,
    "AuthSegmentsPerWindow": 6
  },
  "CacheSettings": {
    "OutputCacheDurationSeconds": 30,
    "QueryCacheDurationMinutes": 5,
    "DistributedCacheSchemaName": "public",
    "DistributedCacheTableName": "Cache"
  },
  "IdentitySettings": {
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireNonAlphanumeric": true,
    "RequireUppercase": true,
    "RequiredLength": 8,
    "RequireUniqueEmail": true
  },
  "AllowedHosts": "*"
}
